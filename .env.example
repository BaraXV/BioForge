# ============================================================
# JAI FORGE — Environment Variables for the Bio Generator
# ============================================================
# Copy this file to ".env.local" and fill in your API key.
# Only ONE option is needed — pick whichever provider you prefer.
# After saving, restart "bun run dev" for changes to take effect.

# ------------------------------------------------------------
# Option 1: OpenAI (paid, highest quality)
# ------------------------------------------------------------
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------
# Option 2: OpenRouter (free models available!)
# ------------------------------------------------------------
# Get your key: https://openrouter.ai/keys
# Then uncomment these three lines:
# OPENAI_API_KEY=sk-or-your-openrouter-key-here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------
# Option 3: Google Gemini (free tier available)
# ------------------------------------------------------------
# Get your key: https://aistudio.google.com/apikey
# Then uncomment these three lines:
# OPENAI_API_KEY=your-gemini-key-here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------
# Option 4: Groq (free, very fast)
# ------------------------------------------------------------
# Get your key: https://console.groq.com/keys
# Then uncomment these three lines:
# OPENAI_API_KEY=your-groq-key-here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------
# Option 5: Local LLM via Ollama (free, runs on your machine)
# ------------------------------------------------------------
# Install Ollama: https://ollama.com
# Run: ollama pull llama3.1
# Then uncomment these three lines:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1
